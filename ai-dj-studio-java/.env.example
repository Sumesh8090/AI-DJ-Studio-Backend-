# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# docker compose reads .env automatically. For `mvn spring-boot:run`, export these in your shell
# (or set them in your IDE run configuration).

# Required, >= 32 chars. Generate with:  openssl rand -base64 48
JWT_SECRET=

# MySQL
DB_URL=jdbc:mysql://localhost:3306/djstudio?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=djstudio
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=         # docker-compose only

ACCESS_TOKEN_MINUTES=15      # must be 1-60 (PRD 10.1)
REFRESH_TOKEN_DAYS=7

# Seed the 7 authored tracks and 5 demo users on startup (idempotent).
APP_SEED_ENABLED=true
# Password for the demo users. If blank a random one is generated and printed once at startup.
SEED_DEMO_PASSWORD=
